#!/bin/sh

if [ "$SYNOPKG_PKG_STATUS" = "INSTALL" ]; then
    AIRCONNECT_CONFIG_FILE="airconnect.conf"
    AIRCONNECT_CONFIG="${SYNOPKG_PKGDEST}/${AIRCONNECT_CONFIG_FILE}"
    AIRCONNECT_USER="$(echo "${SYNOPKG_PKGNAME}" | awk '{print tolower($0)}')"
    LOG="${SYNOPKG_PKGDEST}/log/${AIRCONNECT_USER}.log"

    echo "[$(date +'%T')] #### Start postinst... ####" >>"${LOG}"

    echo "[$(date +'%T')] Creating airconnect config file at \"${AIRCONNECT_CONFIG}\"" >>"$LOG"
    touch "${AIRCONNECT_CONFIG}"

    # shellcheck disable=SC2154
    if [ "${pkgwizard_binaries_aircast}" = "true" ]; then
        {
            echo "[$(date +'%T')] Using installation type for aircast only"
            echo "[$(date +'%T')] Setting AIRCAST_ENABLED=1 in \"${AIRCONNECT_CONFIG}\""
            echo "[$(date +'%T')] Setting AIRCAST_LATENCY=\"50:500\" in \"${AIRCONNECT_CONFIG}\""
            echo "[$(date +'%T')] Setting AIRCAST_LOGLEVEL=\"all=info\" in \"${AIRCONNECT_CONFIG}\""
        } >>"$LOG"
        {
            echo "AIRCAST_ENABLED=1"
            echo "AIRCAST_LATENCY=\"50:500\""
            echo "AIRCAST_LOGLEVEL=\"all=info\""
            echo "AIRUPNP_ENABLED=0"
            echo "AIRUPNP_LATENCY="
            echo "AIRUPNP_CONTENTLENGTH_MODE="
            echo "AIRUPNP_LOGLEVEL="
            echo "AIRUPNP_PORT="
            echo "AIRUPNP_PORTRANGE="
        } >>"${AIRCONNECT_CONFIG}"
    elif [ "${pkgwizard_binaries_airupnp}" = "true" ]; then
        {
            echo "[$(date +'%T')] Using installation type for airupnp only"
            echo "[$(date +'%T')] Setting AIRUPNP_ENABLED=1 in \"${AIRCONNECT_CONFIG}\""
            echo "[$(date +'%T')] Setting AIRUPNP_LATENCY=\"50:500\" in \"${AIRCONNECT_CONFIG}\""
            echo "[$(date +'%T')] Setting AIRUPNP_CONTENTLENGTH_MODE=0 in \"${AIRCONNECT_CONFIG}\""
            echo "[$(date +'%T')] Setting AIRUPNP_LOGLEVEL=\"all=info\" in \"${AIRCONNECT_CONFIG}\""
            echo "[$(date +'%T')] Setting AIRUPNP_PORT=${pkgwizard_airupnp_port} in \"${AIRCONNECT_CONFIG}\""
            echo "[$(date +'%T')] Setting AIRUPNP_PORTRANGE=\"49155:128\" in \"${AIRCONNECT_CONFIG}\""
            echo "[$(date +'%T')] Setting FILTER_AIRPLAY2_DEVICES=\"<NULL>,S1,S3,S5,S9,S12,ZP80,ZP90,S15,ZP100,ZP120,1.0,LibreWireless,Fitzwilliam,2.2.6,AllShare1.0\" in \"${AIRCONNECT_CONFIG}\""
        } >>"$LOG"
        {
            echo "AIRCAST_ENABLED=0"
            echo "AIRCAST_LATENCY="
            echo "AIRCAST_LOGLEVEL="
            echo "AIRUPNP_ENABLED=1"
            echo "AIRUPNP_LATENCY=\"50:500\""
            echo "AIRUPNP_CONTENTLENGTH_MODE=0"
            echo "AIRUPNP_LOGLEVEL=\"all=info\""
            echo "AIRUPNP_PORT=${pkgwizard_airupnp_port}"
            echo "AIRUPNP_PORTRANGE=\"49155:128\""
            echo "FILTER_AIRPLAY2_DEVICES=\"<NULL>,S1,S3,S5,S9,S12,ZP80,ZP90,S15,ZP100,ZP120,1.0,LibreWireless,Fitzwilliam,2.2.6,AllShare1.0\""
        } >>"${AIRCONNECT_CONFIG}"
    else
        {
            echo "[$(date +'%T')] Using installation type for both binaries (airupnp and aircast)"
            echo "[$(date +'%T')] Setting AIRUPNP_ENABLED=1 and AIRCAST_ENABLED=1 in \"${AIRCONNECT_CONFIG}\""
            echo "[$(date +'%T')] Setting AIRCAST_LATENCY=\"50:500\" in \"${AIRCONNECT_CONFIG}\""
            echo "[$(date +'%T')] Setting AIRCAST_LOGLEVEL=\"all=info\" in \"${AIRCONNECT_CONFIG}\""
            echo "[$(date +'%T')] Setting AIRUPNP_LATENCY=\"50:500\" in \"${AIRCONNECT_CONFIG}\""
            echo "[$(date +'%T')] Setting AIRUPNP_CONTENTLENGTH_MODE=0 in \"${AIRCONNECT_CONFIG}\""
            echo "[$(date +'%T')] Setting AIRUPNP_LOGLEVEL=\"all=info\" in \"${AIRCONNECT_CONFIG}\""
            echo "[$(date +'%T')] Setting AIRUPNP_PORT=${pkgwizard_airupnp_port} in \"${AIRCONNECT_CONFIG}\""
            echo "[$(date +'%T')] Setting AIRUPNP_PORTRANGE=\"49155:128\" in \"${AIRCONNECT_CONFIG}\""
            echo "[$(date +'%T')] Setting FILTER_AIRPLAY2_DEVICES=\"<NULL>,S1,S3,S5,S9,S12,ZP80,ZP90,S15,ZP100,ZP120,1.0,LibreWireless,Fitzwilliam,2.2.6,AllShare1.0\" in \"${AIRCONNECT_CONFIG}\""
        } >>"$LOG"
        {
            echo "AIRCAST_ENABLED=1"
            echo "AIRCAST_LATENCY=\"50:500\""
            echo "AIRCAST_LOGLEVEL=\"all=info\""
            echo "AIRUPNP_ENABLED=1"
            echo "AIRUPNP_LATENCY=\"50:500\""
            echo "AIRUPNP_CONTENTLENGTH_MODE=0"
            echo "AIRUPNP_LOGLEVEL=\"all=info\""
            echo "AIRUPNP_PORT=${pkgwizard_airupnp_port}"
            echo "AIRUPNP_PORTRANGE=\"49155:128\""
            echo "FILTER_AIRPLAY2_DEVICES=\"<NULL>,S1,S3,S5,S9,S12,ZP80,ZP90,S15,ZP100,ZP120,1.0,LibreWireless,Fitzwilliam,2.2.6,AllShare1.0\""
        } >>"${AIRCONNECT_CONFIG}"
    fi

    # Setting IP
    # shellcheck disable=SC2154
    echo "[$(date +'%T')] Setting SYNO_IP=\"${pkgwizard_ip}\" in \"${AIRCONNECT_CONFIG}\"" >>"$LOG"
    echo "SYNO_IP=\"${pkgwizard_ip}\"" >>"${AIRCONNECT_CONFIG}"

    # Off by default: linking config/log files into the "airconnect" shared
    # folder requires the user to also enable SMB symlink-following
    # device-wide, which is a real security tradeoff beyond this one
    # package - see the wizard step and README. conf/resource's data-share
    # creates the (empty) shared folder unconditionally regardless of this
    # choice - Synology has no supported way to make that conditional - so
    # if the user didn't opt in, deregister it again here (fresh install
    # only, guaranteed nothing has been placed in it yet). Uses synoshare,
    # the same command already documented as the manual cleanup step under
    # Troubleshooting in the README, so this is known-working for this
    # exact share name, not a guess.
    # shellcheck disable=SC2154
    if [ "${pkgwizard_create_shared_folder}" = "true" ]; then
        echo "[$(date +'%T')] Setting AIRCONNECT_SHARED_FOLDER_LINKS_ENABLED=1 in \"${AIRCONNECT_CONFIG}\" (opted in via wizard)" >>"$LOG"
        echo "AIRCONNECT_SHARED_FOLDER_LINKS_ENABLED=1" >>"${AIRCONNECT_CONFIG}"
    else
        echo "[$(date +'%T')] Setting AIRCONNECT_SHARED_FOLDER_LINKS_ENABLED=0 in \"${AIRCONNECT_CONFIG}\"" >>"$LOG"
        echo "AIRCONNECT_SHARED_FOLDER_LINKS_ENABLED=0" >>"${AIRCONNECT_CONFIG}"
        # data-share (conf/resource) creates the "airconnect" shared folder
        # unconditionally, regardless of this choice - Synology has no
        # supported way to make that conditional, and DSM 7 actively
        # refuses to install any package whose privilege config lets a
        # script run as root (confirmed on real hardware: "Unable to
        # install ... because it runs with root privileges"), so this
        # script - which only ever runs unprivileged on DSM 7 - cannot call
        # synoshare to deregister it either. The folder is left in place,
        # empty and unused; see the README for the manual SSH command to
        # remove it if wanted.
        echo "[$(date +'%T')] Not opted in - the \"airconnect\" shared folder still exists (data-share always creates it) but is empty and unused; nothing is linked into it." >>"$LOG"
    fi

    echo "[$(date +'%T')] #### Done postinst ####" >>"${LOG}"
fi

exit 0
