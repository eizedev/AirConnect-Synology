#!/bin/sh

AIRCONNECT_USER="$(echo "${SYNOPKG_PKGNAME}" | awk '{print tolower($0)}')"
LOG="${SYNOPKG_PKGDEST}/log/${AIRCONNECT_USER}.log"
AIRCONNECT_CONFIG_FILE="airconnect.conf"
AIRCONNECT_CONFIG="${SYNOPKG_PKGDEST}/${AIRCONNECT_CONFIG_FILE}"

echo "[$(date +'%T')] #### Start postupgrade... ####" >>"${LOG}"

# restore config file
/bin/cp -f "${SYNOPKG_TEMP_UPGRADE_FOLDER}/${AIRCONNECT_CONFIG_FILE}" "${SYNOPKG_PKGDEST}"

if [ -f "${AIRCONNECT_CONFIG}" ]; then
    # shellcheck disable=SC2154
    echo "[$(date +'%T')] Checking for missing parameters in config file ${AIRCONNECT_CONFIG} for aircast and correct them, if found"
    grep -Fq "AIRCAST_ENABLED" "${AIRCONNECT_CONFIG}" || { echo "AIRCAST_ENABLED=" >>"${AIRCONNECT_CONFIG}"; }
    grep -Fq "AIRCAST_LOGLEVEL" "${AIRCONNECT_CONFIG}" || { echo "AIRCAST_LOGLEVEL=\"all=info\"" >>"${AIRCONNECT_CONFIG}"; }
    grep -Fq "AIRCAST_LATENCY" "${AIRCONNECT_CONFIG}" || { echo "AIRCAST_LATENCY=\"50:500\"" >>"${AIRCONNECT_CONFIG}"; }

    # shellcheck disable=SC2154
    echo "[$(date +'%T')] Checking for missing parameters in config file ${AIRCONNECT_CONFIG} for airupnp and correct them, if found"
    grep -Fq "AIRUPNP_ENABLED" "${AIRCONNECT_CONFIG}" || { echo "AIRUPNP_ENABLED=" >>"${AIRCONNECT_CONFIG}"; }
    grep -Fq "AIRUPNP_LATENCY" "${AIRCONNECT_CONFIG}" || { echo "AIRUPNP_LATENCY=\"50:500\"" >>"${AIRCONNECT_CONFIG}"; }
    grep -Fq "AIRUPNP_CONTENTLENGTH_MODE" "${AIRCONNECT_CONFIG}" || { echo "AIRUPNP_CONTENTLENGTH_MODE=0" >>"${AIRCONNECT_CONFIG}"; }
    grep -Fq "AIRUPNP_LOGLEVEL" "${AIRCONNECT_CONFIG}" || { echo "AIRUPNP_LOGLEVEL=\"all=info\"" >>"${AIRCONNECT_CONFIG}"; }
    grep -Fq "AIRUPNP_PORT" "${AIRCONNECT_CONFIG}" || { echo "AIRUPNP_PORT=" >>"${AIRCONNECT_CONFIG}"; }
    grep -Fq "AIRUPNP_PORTRANGE" "${AIRCONNECT_CONFIG}" || { echo "AIRUPNP_PORTRANGE=\"49155:128\"" >>"${AIRCONNECT_CONFIG}"; }
    grep -Fq "FILTER_AIRPLAY2_DEVICES" "${AIRCONNECT_CONFIG}" || { echo "FILTER_AIRPLAY2_DEVICES=\"<NULL>,S1,S3,S5,S9,S12,ZP80,ZP90,S15,ZP100,ZP120,1.0,LibreWireless,Fitzwilliam,2.2.6,AllShare1.0\"" >>"${AIRCONNECT_CONFIG}"; }

    # upgrade_uifile.sh shows this choice on every upgrade (pre-selected
    # with whatever it was already set to), so it can be changed here
    # without a full uninstall/reinstall. Drop any existing line first so
    # re-running this doesn't pile up duplicates, then set it fresh from
    # this upgrade's actual answer.
    grep -v '^AIRCONNECT_SHARED_FOLDER_LINKS_ENABLED=' "${AIRCONNECT_CONFIG}" >"${AIRCONNECT_CONFIG}.tmp" && mv "${AIRCONNECT_CONFIG}.tmp" "${AIRCONNECT_CONFIG}"
    # shellcheck disable=SC2154
    if [ "${pkgwizard_create_shared_folder}" = "true" ]; then
        NEW_SHARED_FOLDER_LINKS_ENABLED=1
    elif [ -n "${pkgwizard_create_shared_folder}" ]; then
        NEW_SHARED_FOLDER_LINKS_ENABLED=0
    elif [ -e "${SYNOPKG_PKGDEST_VOL}/airconnect/${AIRCONNECT_CONFIG_FILE}" ]; then
        # upgrade_uifile.sh didn't run for some reason - fall back to
        # whatever this install was already doing rather than silently
        # taking away access it was relying on.
        NEW_SHARED_FOLDER_LINKS_ENABLED=1
    else
        NEW_SHARED_FOLDER_LINKS_ENABLED=0
    fi
    echo "AIRCONNECT_SHARED_FOLDER_LINKS_ENABLED=${NEW_SHARED_FOLDER_LINKS_ENABLED}" >>"${AIRCONNECT_CONFIG}"

    # If shared-folder links are now off, clean up any symlinks left over
    # from when they were on - never config.xml/config-cast.xml, and never
    # the shared folder itself if either of those (or anything else real)
    # is still there, since their *real* file can legitimately live inside
    # the shared folder if the user placed a custom one there. Runs here
    # rather than in start-stop-status because that's where the toggle
    # transition is detected; removing individual symlinks doesn't need
    # elevated privilege (the "airconnect" group already has rw on the
    # folder via data-share). Deregistering the folder itself would need
    # synoshare, which needs root - DSM 7 refuses to even install a
    # package whose privilege config lets any script run as root
    # (confirmed on real hardware), so that part isn't automatable here;
    # see the README for the manual SSH command if wanted.
    if [ "${NEW_SHARED_FOLDER_LINKS_ENABLED}" = "0" ]; then
        AIRCONNECT_DESTINATION="${SYNOPKG_PKGDEST_VOL}/airconnect"
        if [ -d "${AIRCONNECT_DESTINATION}" ]; then
            [ -L "${AIRCONNECT_DESTINATION}/${AIRCONNECT_CONFIG_FILE}" ] && rm -f "${AIRCONNECT_DESTINATION}/${AIRCONNECT_CONFIG_FILE}"
            [ -L "${AIRCONNECT_DESTINATION}/${AIRCONNECT_USER}.log" ] && rm -f "${AIRCONNECT_DESTINATION}/${AIRCONNECT_USER}.log"
            # @eaDir (Synology's own metadata dir, auto-created on every
            # shared folder) and .DS_Store/Thumbs.db/desktop.ini (created
            # just by browsing the folder in Finder/Explorer) don't count
            # as real content - a folder with only these is still "empty".
            # Globs instead of ls|grep so a filename with a newline or
            # other odd character can't confuse this.
            SHARE_REAL_CONTENTS=""
            for entry in "${AIRCONNECT_DESTINATION}"/* "${AIRCONNECT_DESTINATION}"/.[!.]*; do
                [ -e "$entry" ] || continue
                entry_name=$(basename "$entry")
                case "$entry_name" in
                '@eaDir' | '.DS_Store' | 'Thumbs.db' | 'desktop.ini') ;;
                *) SHARE_REAL_CONTENTS="${SHARE_REAL_CONTENTS}${entry_name} " ;;
                esac
            done
            if [ -z "${SHARE_REAL_CONTENTS}" ]; then
                echo "[$(date +'%T')] Symlinks removed - the (now empty, unused) \"airconnect\" shared folder itself stays registered; see the README for how to remove it manually if wanted." >>"${LOG}"
            else
                echo "[$(date +'%T')] Shared folder \"airconnect\" still has content after removing this package's own symlinks - leaving it in place (contents: ${SHARE_REAL_CONTENTS})" >>"${LOG}"
                echo "The \"airconnect\" shared folder was kept because it still contains: ${SHARE_REAL_CONTENTS}(this package's own config/log links were removed)" >>"${SYNOPKG_TEMP_LOGFILE}"
            fi
        fi
    fi
fi

echo "[$(date +'%T')] #### Done postupgrade ####" >>"${LOG}"

exit 0
