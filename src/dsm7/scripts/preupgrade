#!/bin/sh

AIRCONNECT_USER="$(echo "${SYNOPKG_PKGNAME}" | awk '{print tolower($0)}')"
LOG="${SYNOPKG_PKGDEST}/log/${AIRCONNECT_USER}.log"
AIRCONNECT_CONFIG_FILE="airconnect.conf"
# Where the config is parked during the update. SRM sets neither
# SYNOPKG_TEMP_UPGRADE_FOLDER nor SYNOPKG_PKGVAR (measured on SRM 1.3.2);
# /tmp survives from preupgrade to postupgrade there. Same expression in
# preupgrade and postupgrade.
UPGRADE_DIR="${SYNOPKG_TEMP_UPGRADE_FOLDER:-/tmp/${SYNOPKG_PKGNAME}-upgrade}"

echo "[$(date +'%T')] #### Start preupgrade... ####" >>"${LOG}"

# Stop the update and tell DSM why. This is deliberately a hard stop:
# DSM keeps the installed version.
refuse() {
    echo "[$(date +'%T')] $1" >>"${LOG}"
    echo "$1" >>"${SYNOPKG_TEMP_LOGFILE}"
    exit 1
}

# An update carries over the settings of the installed package. If they
# are not there, they cannot be carried over, and guessing them would
# silently change how the package runs - so refuse, and say what to do.
if [ ! -f "${SYNOPKG_PKGDEST}/${AIRCONNECT_CONFIG_FILE}" ]; then
    refuse "Cannot update: the installed AirConnect has no ${AIRCONNECT_CONFIG_FILE}, so its settings cannot be carried over. Please uninstall the package and install it again."
fi

# The update replaces the package directory, so the config has to be parked
# first. A copy that fails stops the update for the same reason as a missing
# config: continuing would leave the package without its settings.
{ { [ -n "${SYNOPKG_TEMP_UPGRADE_FOLDER}" ] || [ -d "${UPGRADE_DIR}" ] || mkdir -m 700 "${UPGRADE_DIR}"; } &&
    /bin/cp -f "${SYNOPKG_PKGDEST}/${AIRCONNECT_CONFIG_FILE}" "${UPGRADE_DIR}"; } 2>>"${LOG}" ||
    refuse "Cannot update: ${AIRCONNECT_CONFIG_FILE} could not be saved for the update. The package log has the details."

echo "[$(date +'%T')] #### Done preupgrade ####" >>"${LOG}"

exit 0
