#!/bin/sh

AIRCONNECT_USER="$(echo "${SYNOPKG_PKGNAME}" | awk '{print tolower($0)}')"
LOG="${SYNOPKG_PKGDEST}/log/${AIRCONNECT_USER}.log"
AIRCONNECT_CONFIG_FILE="airconnect.conf"
AIRCONNECT_CONFIG="${SYNOPKG_PKGDEST}/${AIRCONNECT_CONFIG_FILE}"

echo "[$(date +'%T')] #### Start postupgrade... ####" >>"${LOG}"

# restore config file
/bin/cp -f "${SYNOPKG_TEMP_UPGRADE_FOLDER}/${AIRCONNECT_CONFIG_FILE}" "${SYNOPKG_PKGDEST}"

# upgrade_uifile.sh offers this choice on every upgrade, preselected with
# the current setting, so it can be changed here without a full
# uninstall/reinstall. It leaves the checkbox out entirely when it cannot
# read the current setting, and then nothing is submitted for it - which
# is why an empty answer keeps the old value instead of counting as
# "unchecked". An upgrade must never turn this off by itself: that removes
# the links and takes away access the install was relying on.
if [ -f "${AIRCONNECT_CONFIG}" ]; then
    # The config restored above is the old one, so it still carries the
    # old answer - the fallback for everything below.
    OLD_SHARED_FOLDER_LINKS_ENABLED=$(sed -n 's/^AIRCONNECT_SHARED_FOLDER_LINKS_ENABLED=\(.*\)/\1/p' "${AIRCONNECT_CONFIG}" | tail -n 1)
    if [ -z "${OLD_SHARED_FOLDER_LINKS_ENABLED}" ] && [ -e "${SYNOPKG_PKGDEST_VOL}/airconnect/${AIRCONNECT_CONFIG_FILE}" ]; then
        # Config predates the setting, but the links are there, so this
        # install is using them.
        OLD_SHARED_FOLDER_LINKS_ENABLED=1
    fi

    grep -v '^AIRCONNECT_SHARED_FOLDER_LINKS_ENABLED=' "${AIRCONNECT_CONFIG}" >"${AIRCONNECT_CONFIG}.tmp" && mv "${AIRCONNECT_CONFIG}.tmp" "${AIRCONNECT_CONFIG}"
    # shellcheck disable=SC2154
    if [ "${pkgwizard_create_shared_folder}" = "true" ]; then
        NEW_SHARED_FOLDER_LINKS_ENABLED=1
    elif [ -n "${pkgwizard_create_shared_folder}" ]; then
        NEW_SHARED_FOLDER_LINKS_ENABLED=0
    else
        NEW_SHARED_FOLDER_LINKS_ENABLED=${OLD_SHARED_FOLDER_LINKS_ENABLED:-0}
    fi
    echo "[$(date +'%T')] Shared-folder links: was \"${OLD_SHARED_FOLDER_LINKS_ENABLED:-unset}\", wizard answered \"${pkgwizard_create_shared_folder:-none}\", now \"${NEW_SHARED_FOLDER_LINKS_ENABLED}\"" >>"${LOG}"
    echo "AIRCONNECT_SHARED_FOLDER_LINKS_ENABLED=${NEW_SHARED_FOLDER_LINKS_ENABLED}" >>"${AIRCONNECT_CONFIG}"

    # If shared-folder links are now off, clean up any symlinks left over
    # from when they were on - never config.xml/config-cast.xml, and never
    # the shared folder itself if either of those (or anything else real)
    # is still there, since their *real* file can legitimately live inside
    # the shared folder if the user placed a custom one there. Runs here
    # (not in start-stop-status) for consistency with the dsm7 tree, where
    # this script runs as root (see conf/privilege) and can actually call
    # synoshare - start-stop-status runs unprivileged there and confirmed
    # cannot ("Permission denied"). This legacy tree runs everything as
    # root anyway, but the logic stays in one place for both.
    if [ "${NEW_SHARED_FOLDER_LINKS_ENABLED}" = "0" ]; then
        AIRCONNECT_DESTINATION="${SYNOPKG_PKGDEST_VOL}/airconnect"
        if [ -d "${AIRCONNECT_DESTINATION}" ]; then
            [ -L "${AIRCONNECT_DESTINATION}/${AIRCONNECT_CONFIG_FILE}" ] && rm -f "${AIRCONNECT_DESTINATION}/${AIRCONNECT_CONFIG_FILE}"
            [ -L "${AIRCONNECT_DESTINATION}/${AIRCONNECT_USER}.log" ] && rm -f "${AIRCONNECT_DESTINATION}/${AIRCONNECT_USER}.log"
            # @eaDir (Synology's own metadata dir, auto-created on every
            # shared folder) and .DS_Store/Thumbs.db/desktop.ini (created
            # just by browsing the folder in Finder/Explorer) don't count
            # as real content - a folder with only these is still "empty".
            # Globs instead of ls|grep so a filename with a newline or
            # other odd character can't confuse this.
            SHARE_REAL_CONTENTS=""
            for entry in "${AIRCONNECT_DESTINATION}"/* "${AIRCONNECT_DESTINATION}"/.[!.]*; do
                [ -e "$entry" ] || continue
                entry_name=$(basename "$entry")
                case "$entry_name" in
                '@eaDir' | '.DS_Store' | 'Thumbs.db' | 'desktop.ini') ;;
                *) SHARE_REAL_CONTENTS="${SHARE_REAL_CONTENTS}${entry_name} " ;;
                esac
            done
            if [ -z "${SHARE_REAL_CONTENTS}" ]; then
                echo "[$(date +'%T')] Removing unused, empty shared folder \"airconnect\" (not opted in)" >>"${LOG}"
                synoshare --del TRUE airconnect >>"${LOG}" 2>&1 || true
            else
                echo "[$(date +'%T')] Shared folder \"airconnect\" still has content after removing this package's own symlinks - leaving it in place (contents: ${SHARE_REAL_CONTENTS})" >>"${LOG}"
                echo "The \"airconnect\" shared folder was kept because it still contains: ${SHARE_REAL_CONTENTS}(this package's own config/log links were removed)" >>"${SYNOPKG_TEMP_LOGFILE}"
            fi
        fi
    fi
fi

echo "[$(date +'%T')] #### Done postupgrade ####" >>"${LOG}"

exit 0
