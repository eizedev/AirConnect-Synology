#!/bin/sh

AIRCONNECT_USER="$(echo "${SYNOPKG_PKGNAME}" | awk '{print tolower($0)}')"
LOG="${SYNOPKG_PKGDEST}/log/${AIRCONNECT_USER}.log"
AIRCONNECT_CONFIG_FILE="airconnect.conf"
AIRCONNECT_CONFIG="${SYNOPKG_PKGDEST}/${AIRCONNECT_CONFIG_FILE}"

echo "[$(date +'%T')] #### Start postupgrade... ####" >>"${LOG}"

# restore config file
/bin/cp -f "${SYNOPKG_TEMP_UPGRADE_FOLDER}/${AIRCONNECT_CONFIG_FILE}" "${SYNOPKG_PKGDEST}"

# upgrade_uifile.sh shows this choice on every upgrade (pre-selected with
# whatever it was already set to), so it can be changed here without a
# full uninstall/reinstall. Drop any existing line first so re-running
# this doesn't pile up duplicates, then set it fresh from this upgrade's
# actual answer.
if [ -f "${AIRCONNECT_CONFIG}" ]; then
    grep -v '^AIRCONNECT_SHARED_FOLDER_LINKS_ENABLED=' "${AIRCONNECT_CONFIG}" >"${AIRCONNECT_CONFIG}.tmp" && mv "${AIRCONNECT_CONFIG}.tmp" "${AIRCONNECT_CONFIG}"
    # shellcheck disable=SC2154
    if [ "${pkgwizard_create_shared_folder}" = "true" ]; then
        echo "AIRCONNECT_SHARED_FOLDER_LINKS_ENABLED=1" >>"${AIRCONNECT_CONFIG}"
    elif [ -n "${pkgwizard_create_shared_folder}" ]; then
        echo "AIRCONNECT_SHARED_FOLDER_LINKS_ENABLED=0" >>"${AIRCONNECT_CONFIG}"
    elif [ -e "${SYNOPKG_PKGDEST_VOL}/airconnect/${AIRCONNECT_CONFIG_FILE}" ]; then
        # upgrade_uifile.sh didn't run for some reason - fall back to
        # whatever this install was already doing rather than silently
        # taking away access it was relying on.
        echo "AIRCONNECT_SHARED_FOLDER_LINKS_ENABLED=1" >>"${AIRCONNECT_CONFIG}"
    else
        echo "AIRCONNECT_SHARED_FOLDER_LINKS_ENABLED=0" >>"${AIRCONNECT_CONFIG}"
    fi
fi

echo "[$(date +'%T')] #### Done postupgrade ####" >>"${LOG}"

exit 0
